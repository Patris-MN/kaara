# Copy this file to `.env` in the same folder before running docker compose.
# Never commit the real `.env` file — it is already covered by the root .gitignore.

# --- PostgreSQL server (superuser, used only by the container's init process) ---
POSTGRES_DB=pts
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# --- migrator_role: owns the schema, runs EF Core migrations and RLS policy DDL. ---
# Used by developer tooling / CI migration jobs — never by the running application.
PTS_MIGRATOR_PASSWORD=change-me-migrator

# --- app_role: used by the running ASP.NET Core application at runtime. ---
# Must never own the database, bypass RLS, or hold DDL permissions.
PTS_APP_PASSWORD=change-me-app

# --- Host port mapping ---
POSTGRES_HOST_PORT=5432
